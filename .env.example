DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hitry_lis_crm"
POSTGRES_DB="hitry_lis_crm"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# сессии
SESSION_TTL_DAYS="30"
# в проде за HTTPS -> true
COOKIE_SECURE="false"

# --- прод (docker-compose.prod.yml) ---
# домен API для Caddy (или ":80" для демо по IP без TLS, тогда COOKIE_SECURE=0)
API_DOMAIN=":80"
