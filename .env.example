DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hitry_lis_crm"
POSTGRES_DB="hitry_lis_crm"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# склад/меню/заказы — отдельная БД, создаётся вручную (CREATE DATABASE), не
# пересекается с учётками/играми в hitry_lis_crm
WAREHOUSE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hitry_lis_warehouse"
WAREHOUSE_POSTGRES_DB="hitry_lis_warehouse"

# сессии
SESSION_TTL_DAYS="30"
# в проде за HTTPS -> true
COOKIE_SECURE="false"

# --- прод (docker-compose.prod.yml) ---
# домен API для Caddy (или ":80" для демо по IP без TLS, тогда COOKIE_SECURE=0)
API_DOMAIN=":80"

# сколько дней держим журнал audit_events (cleanup.py)
AUDIT_KEEP_DAYS="90"
